{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/v0.1.0-preview.1": false
    }
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{assets/**,works/**,css/**,js/**,*.html,*.md,*.xml,*.txt}"
    }
  }
}
